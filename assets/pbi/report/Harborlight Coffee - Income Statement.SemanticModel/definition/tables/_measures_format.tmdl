	measure fmt_applied_filters = ```
			
			    VAR _hdrBg = [fmt_mode_header_background]
			    VAR _accent = [fmt_mode_accent_color]
			    VAR _hdrText = [fmt_mode_header_text]
			    VAR _pillText = [fmt_mode_header_text]
			    VAR vReportDate = [fmt_report_date] 
			    VAR vGroup = [fmt_region] 
			    VAR vIndustry = [fmt_state] 
			    VAR vClient = [fmt_location] 
			    VAR vStatus = [fmt_market_tier]
			    VAR vRunGroup = "All"
			
			    VAR PillBaseStyle = "display: inline-flex; align-items: center; padding: 0.15rem 0.6rem; /* Reduced vertical padding */ border-radius: 9999px; font-size: 12px; /* Set font size */ line-height: 1; /* Adjusted line height */ font-weight: 500; white-space: nowrap; " 
			    VAR PillColors = "background-color: rgba(255, 255, 255, 0.2); color: " & _pillText & ";"
			    VAR PillStyle = PillBaseStyle & PillColors
			
			    VAR ReportDatePill = IF( NOT ISBLANK(vReportDate) && LOWER(vReportDate) <> "all", " <span style=""" & PillStyle & """ title=""Report Date: " & vReportDate & """><strong style=""margin-right: 0.25rem;"">Report Date:</strong><span>" & vReportDate & "</span></span>", "" )
			    VAR GroupPill = IF( NOT ISBLANK(vGroup) && LOWER(vGroup) <> "all", " <span style=""" & PillStyle & """ title=""Region: " & vGroup & """><strong style=""margin-right: 0.25rem;"">Region:</strong><span>" & vGroup & "</span></span>", "" )
			    VAR IndustryPill = IF( NOT ISBLANK(vIndustry) && LOWER(vIndustry) <> "all", " <span style=""" & PillStyle & """ title=""State: " & vIndustry & """><strong style=""margin-right: 0.25rem;"">State:</strong><span>" & vIndustry & "</span></span>", "" )
			    VAR ClientPill = IF( NOT ISBLANK(vClient) && LOWER(vClient) <> "all", " <span style=""" & PillStyle & """ title=""Location: " & vClient & """><strong style=""margin-right: 0.25rem;"">Location:</strong><span>" & vClient & "</span></span>", "" )
			    VAR StatusPill = IF( NOT ISBLANK(vStatus) && LOWER(vStatus) <> "all", " <span style=""" & PillStyle & """ title=""Tier: " & vStatus & """><strong style=""margin-right: 0.25rem;"">Tier:</strong><span>" & vStatus & "</span></span>", "" )
			    VAR RunGroupPill = IF( NOT ISBLANK(vRunGroup) && LOWER(vRunGroup) <> "all", " <span style=""" & PillStyle & """ title=""Run Group " & vRunGroup & """><strong style=""margin-right: 0.25rem;"">Run Group</strong><span>" & vRunGroup & "</span></span>", "" )
			
			    VAR HtmlContent = "
			    <div style="" /* Main container - Should be placed in an HTML Content visual */
			        background-color: " & _hdrBg & "; /* Set desired header dark blue background */
			        padding: 0.2rem 0.5rem; /* Reduced vertical padding */ 
			        font-family: 'Segoe UI', sans-serif; /* Set font family */
			        display: flex; 
			        align-items: center; /* Align items vertically in the center */
			        box-sizing: border-box; 
			        /* REMOVED height: 100%; */
			        overflow: hidden; /* Hide overflow to prevent expansion */
			    "">
			        <div style="" /* Yellow Accent Bar */
			            width: 5px; 
			            background-color: " & _accent & "; /* Yellow accent */
			            border-radius: 9999px; 
			            margin-right: 0.75rem; /* Space between bar and content */
			            align-self: stretch; /* Make bar fill height */
			        ""></div>
			
			        <div style="" /* Inner container for label and pills */
			            background-color: transparent; 
			            display: flex; 
			            flex-direction: column; 
			            flex-grow: 1; 
			            min-width: 0; 
			            justify-content: center; 
			        "">
			            <h2 style="" /* Applied Filters Label */
			                background-color: transparent;
			                font-size: 12px; /* Set font size */
			                line-height: 1.2; /* Adjusted line height */
			                font-weight: 600; 
			                color: " & _hdrText & "; /* White text for contrast on dark blue */
			                text-transform: uppercase; 
			                letter-spacing: 0.05em; 
			                margin: 0 0 0.15rem 0; /* Reduced margin-bottom */
			                white-space: nowrap; 
			                overflow: hidden;
			                text-overflow: ellipsis;
			            "">
			                Applied Filters:
			            </h2>
			            <div style="" /* Container for the pills */
			                background-color: transparent;
			                display: flex; 
			                flex-wrap: wrap; 
			                gap: 0.25rem; /* Reduced gap (~4px) */
			                min-width: 0; 
			                line-height: 1; /* Control line height for wrapping */
			            "">
			                " 
			                & ReportDatePill 
			                & GroupPill 
			                & IndustryPill 
			                & ClientPill 
			                & StatusPill 
			                & RunGroupPill & "
			            </div>
			        </div>
			    </div>
			    "
			    RETURN HtmlContent
			```
		lineageTag: 4b3e2134-7c6a-47f2-9b1d-7a3a9f537a6b

