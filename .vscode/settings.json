{
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.eol": "\n",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/node_modules/**": true,
        ".tmp": true
    },
    "files.exclude": {
        ".tmp": true
    },
    "files.associations": {
        "*.resjson": "json"
    },
    "search.exclude": {
        ".tmp": true,
        "typings": true
    },
    "json.schemas": [
        {
            "fileMatch": [
                "/pbiviz.json"
            ],            
            "url": "./node_modules/powerbi-visuals-api/schema.pbiviz.json"
        },
        {
            "fileMatch": [
                "/capabilities.json"
            ],            
            "url": "./node_modules/powerbi-visuals-api/schema.capabilities.json"
        },
        {
            "fileMatch": [
                "/dependencies.json"
            ],            
            "url": "./node_modules/powerbi-visuals-api/schema.dependencies.json"
        }        
    ],
    "chat.agentSkillsLocations": {
        ".agents/skills": true,
        ".github/skills": true,
        ".claude/skills": true,
        "~/.agents/skills": true,
        "~/.copilot/skills": true,
        "~/.claude/skills": true,
        "~/.vscode/extensions/synapsevscode.synapse-1.26.0/copilot/skills": true
    }
}