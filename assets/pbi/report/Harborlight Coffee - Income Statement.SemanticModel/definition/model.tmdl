model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Facts

	annotation PBI_QueryGroupOrder = 1

queryGroup Dimension

	annotation PBI_QueryGroupOrder = 2

annotation PBI_QueryOrder = ["_measures_format", "_measures_kpi", "dim_icons", "dim_calendar", "dim_last_refresh", "cg_time_intelligence", "fact_income_statement", "dim_locations", "IncomeStatementLayout", "dim_mode", "p_sql_endpoint", "p_lakehouse", "p_start_date", "p_data_folder"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DaxQueryView_Desktop","TMDLView_Desktop","DevMode","WebModelingEdit"]

ref table _measures_format
ref table _measures_kpi
ref table dim_icons
ref table dim_calendar
ref table dim_last_refresh
ref table cg_time_intelligence
ref table fact_income_statement
ref table dim_locations
ref table IncomeStatementLayout
ref table dim_mode

ref cultureInfo en-US

