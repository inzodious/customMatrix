	column placeholder
		dataType: string
		isHidden
		lineageTag: 2bcc29f7-95aa-ac27-2e49-c2fe64fa1864
		summarizeBy: none
		sourceColumn: placeholder

		annotation SummarizationSetBy = Automatic

	partition _measures_format = m
		mode: import
		source =
				let
				    Source = Table.FromRows({}, type table [placeholder = text])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

